<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<VBox xmlns:fx="http://javafx.com/fxml" spacing="14" alignment="CENTER" style="-fx-background-color: #f2f5fa; -fx-padding: 32;">
  <Label fx:id="heading" text="VN Code — Live Preview" style="-fx-font-size: 24px; -fx-text-fill: #172554;"/>
  <Label fx:id="subtitle" text="Safe sample screen (no production services)" style="-fx-font-size: 14px;"/>
  <Button fx:id="fbsButton" text="Đơn FBS" prefWidth="190" style="-fx-background-color: #dbeafe;"/>
  <Button fx:id="gtinButton" text="GTIN / KIZ" prefWidth="190"/>
</VBox>
