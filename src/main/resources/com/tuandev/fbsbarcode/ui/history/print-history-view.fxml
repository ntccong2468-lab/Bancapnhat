<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.history.PrintHistoryController">
    <children>
        <Label fx:id="titleLabel" styleClass="h2" text="История печати" />
        <Label fx:id="emptyStateLabel" styleClass="text-muted" text="Для этого магазина пока нет истории печати." wrapText="true" />
        <TableView fx:id="jobsTable" managed="false" prefHeight="260.0" visible="false">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="printedAtTC" prefWidth="160.0" text="Дата печати" />
                <TableColumn fx:id="supplyNameTC" prefWidth="180.0" text="Название поставки" />
                <TableColumn fx:id="supplyIdTC" prefWidth="150.0" text="ID поставки" />
                <TableColumn fx:id="itemCountTC" prefWidth="110.0" text="Кол-во товаров" />
                <TableColumn fx:id="statusTC" prefWidth="100.0" text="Статус" />
                <TableColumn fx:id="actionTC" prefWidth="72.0" text="" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
</VBox>
