<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="980.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.supply.SupplyManagementController">
    <center>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <children>
                <StackPane fx:id="supplyListContainer" />
                <StackPane fx:id="supplyDetailContainer" VBox.vgrow="ALWAYS" />
            </children>
            <padding>
                <Insets bottom="0.0" left="0.0" right="12.0" top="0.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
