<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuandev.fbsbarcode.ui.dashboard.DashboardController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="titleLabel" styleClass="h2" text="Dashboard" />
                <ProgressIndicator fx:id="loadingIndicator" managed="false" maxHeight="18.0" maxWidth="18.0" prefHeight="18.0" prefWidth="18.0" visible="false" />
                <Label fx:id="statusLabel" styleClass="text-muted" text="" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefresh" prefHeight="28.0" text="Refresh">
                    <graphic>
                        <FontIcon iconLiteral="fth-refresh-cw" iconSize="15" />
                    </graphic>
                </Button>
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <VBox spacing="4.0" styleClass="surface" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="productKpiLabel" styleClass="text-muted" text="Sản phẩm" />
                        <Label fx:id="productCountLabel" styleClass="h1" text="0" />
                    </children>
                </VBox>
                <VBox spacing="4.0" styleClass="surface" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="newOrdersKpiLabel" styleClass="text-muted" text="Đơn mới" />
                        <Label fx:id="newOrderCountLabel" styleClass="h1" text="0" />
                    </children>
                </VBox>
                <VBox spacing="4.0" styleClass="surface" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="openSuppliesKpiLabel" styleClass="text-muted" text="Supply mở" />
                        <Label fx:id="openSupplyCountLabel" styleClass="h1" text="0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <Label fx:id="emptyStateLabel" managed="false" styleClass="text-muted" text="Chưa có dữ liệu sản phẩm local. Hãy sync shop trước." visible="false" />
    </children>
</VBox>
