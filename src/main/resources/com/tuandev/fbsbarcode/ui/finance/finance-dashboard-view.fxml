<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12.0" styleClass="finance-dashboard" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tuandev.fbsbarcode.ui.finance.FinanceDashboardController">
    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0" /></padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label fx:id="titleLabel" styleClass="h2" text="Finance" />
            <ProgressIndicator fx:id="loadingIndicator" managed="false" maxHeight="18.0" maxWidth="18.0"
                               prefHeight="18.0" prefWidth="18.0" visible="false" />
            <Label fx:id="statusLabel" styleClass="text-muted" text="" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="syncButton" mnemonicParsing="false" onAction="#onSync" text="Sync WB">
                <graphic><FontIcon iconLiteral="fth-download-cloud" iconSize="15" /></graphic>
            </Button>
            <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefresh" text="Refresh">
                <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="15" /></graphic>
            </Button>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="surface finance-filter-bar">
            <Button fx:id="sevenDaysButton" onAction="#onSevenDays" text="7 days" />
            <Button fx:id="thirtyDaysButton" onAction="#onThirtyDays" text="30 days" />
            <Button fx:id="ninetyDaysButton" onAction="#onNinetyDays" text="90 days" />
            <HBox minWidth="12.0" />
            <Label fx:id="fromDateLabel" styleClass="finance-filter-label" text="From" />
            <DatePicker fx:id="fromDatePicker" onAction="#onDateRangeChanged" prefWidth="145.0" />
            <Label fx:id="toDateLabel" styleClass="finance-filter-label" text="To" />
            <DatePicker fx:id="toDatePicker" onAction="#onDateRangeChanged" prefWidth="145.0" />
        </HBox>

        <GridPane fx:id="kpiGrid" hgap="14.0" vgap="14.0" styleClass="finance-kpi-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="20.0" />
                <ColumnConstraints percentWidth="20.0" />
                <ColumnConstraints percentWidth="20.0" />
                <ColumnConstraints percentWidth="20.0" />
                <ColumnConstraints percentWidth="20.0" />
            </columnConstraints>
            <children>
                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-revenue"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label fx:id="grossTitleLabel" styleClass="finance-kpi-title" text="Sales" />
                    <Label fx:id="grossValueLabel" styleClass="finance-kpi-value finance-kpi-value-revenue" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-income"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label fx:id="payoutTitleLabel" styleClass="finance-kpi-title" text="Payout" />
                    <Label fx:id="payoutValueLabel" styleClass="finance-kpi-value finance-kpi-value-income" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-cost"
                      GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label fx:id="commissionTitleLabel" styleClass="finance-kpi-title" text="Commission" />
                    <Label fx:id="commissionValueLabel" styleClass="finance-kpi-value finance-kpi-value-cost" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-danger"
                      GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label fx:id="returnsTitleLabel" styleClass="finance-kpi-title" text="Returns" />
                    <Label fx:id="returnsValueLabel" styleClass="finance-kpi-value finance-kpi-value-danger" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-cost"
                      GridPane.columnIndex="4" GridPane.rowIndex="0">
                    <Label fx:id="logisticsTitleLabel" styleClass="finance-kpi-title" text="Logistics" />
                    <Label fx:id="logisticsValueLabel" styleClass="finance-kpi-value finance-kpi-value-cost" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-cost"
                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label fx:id="advertisingTitleLabel" styleClass="finance-kpi-title" text="Advertising" />
                    <Label fx:id="advertisingValueLabel" styleClass="finance-kpi-value finance-kpi-value-cost" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-cost"
                      GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label fx:id="storageTitleLabel" styleClass="finance-kpi-title" text="Storage" />
                    <Label fx:id="storageValueLabel" styleClass="finance-kpi-value finance-kpi-value-cost" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-danger"
                      GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <Label fx:id="penaltyTitleLabel" styleClass="finance-kpi-title" text="Penalties" />
                    <Label fx:id="penaltyValueLabel" styleClass="finance-kpi-value finance-kpi-value-danger" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-cost"
                      GridPane.columnIndex="3" GridPane.rowIndex="1">
                    <Label fx:id="otherCostTitleLabel" styleClass="finance-kpi-title" text="Other costs" />
                    <Label fx:id="otherCostValueLabel" styleClass="finance-kpi-value finance-kpi-value-cost" text="0" />
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="5.0"
                      styleClass="surface finance-kpi-card finance-kpi-card-net"
                      GridPane.columnIndex="4" GridPane.rowIndex="1">
                    <Label fx:id="netTitleLabel" styleClass="finance-kpi-title" text="Net" />
                    <Label fx:id="netValueLabel" styleClass="finance-kpi-value finance-kpi-value-positive" text="0" />
                </VBox>
            </children>
        </GridPane>

        <Label fx:id="emptyLabel" managed="false" styleClass="text-muted" text="No finance data" visible="false" />
        <TableView fx:id="dailyTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
                <TableColumn fx:id="salesColumn" prefWidth="130.0" styleClass="finance-money-column" text="Sales" />
                <TableColumn fx:id="payoutColumn" prefWidth="145.0" styleClass="finance-money-column" text="Payout" />
                <TableColumn fx:id="commissionColumn" prefWidth="125.0" styleClass="finance-money-column" text="Commission" />
                <TableColumn fx:id="returnsColumn" prefWidth="115.0" styleClass="finance-money-column" text="Returns" />
                <TableColumn fx:id="logisticsColumn" prefWidth="120.0" styleClass="finance-money-column" text="Logistics" />
                <TableColumn fx:id="advertisingColumn" prefWidth="120.0" styleClass="finance-money-column" text="Advertising" />
                <TableColumn fx:id="storageColumn" prefWidth="110.0" styleClass="finance-money-column" text="Storage" />
                <TableColumn fx:id="penaltyColumn" prefWidth="110.0" styleClass="finance-money-column" text="Penalties" />
                <TableColumn fx:id="otherCostColumn" prefWidth="125.0" styleClass="finance-money-column" text="Other costs" />
                <TableColumn fx:id="netColumn" prefWidth="135.0" styleClass="finance-money-column" text="Net" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
        </TableView>
    </children>
</VBox>
