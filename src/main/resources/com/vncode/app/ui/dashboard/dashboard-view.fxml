<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="6.0" minHeight="0" minWidth="0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vncode.app.ui.dashboard.DashboardController" styleClass="app-page,dashboard-workspace">
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="titleLabel" styleClass="h2" text="Dashboard" />
                <ProgressIndicator fx:id="loadingIndicator" managed="false" maxHeight="18.0" maxWidth="18.0" prefHeight="18.0" prefWidth="18.0" visible="false" />
                <Label fx:id="statusLabel" styleClass="text-muted" text="" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefresh" prefHeight="28.0" text="Refresh">
                    <graphic>
                        <FontIcon iconLiteral="fth-refresh-cw" iconSize="15" />
                    </graphic>
                </Button>
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <VBox spacing="4.0" styleClass="surface,dashboard-metric" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="productKpiLabel" styleClass="text-muted" text="Sản phẩm" />
                        <Label fx:id="productCountLabel" styleClass="h1" text="0" />
                    </children>
                </VBox>
                <VBox spacing="4.0" styleClass="surface,dashboard-metric" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="newOrdersKpiLabel" styleClass="text-muted" text="Đơn mới" />
                        <Label fx:id="newOrderCountLabel" styleClass="h1" text="0" />
                    </children>
                </VBox>
                <VBox spacing="4.0" styleClass="surface,dashboard-metric" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="openSuppliesKpiLabel" styleClass="text-muted" text="Supply mở" />
                        <Label fx:id="openSupplyCountLabel" styleClass="h1" text="0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <Label fx:id="emptyStateLabel" managed="false" styleClass="text-muted" text="Chưa có dữ liệu sản phẩm local. Hãy sync shop trước." visible="false" />
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label fx:id="penaltyTitleLabel" styleClass="h3" text="Giao dịch phạt" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button fx:id="penaltySyncButton" onAction="#onPenaltySync" text="Đồng bộ tài chính" />
            </children>
        </HBox>
        <Label fx:id="penaltyHelpLabel" styleClass="text-muted" wrapText="true" text="Mô tả theo dữ liệu sàn đã đồng bộ; có thể chưa có lý do chi tiết." />
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label fx:id="penaltyFromLabel" minWidth="-Infinity" text="Từ" />
                <DatePicker fx:id="penaltyFromDate" minWidth="170.0" prefWidth="170.0" onAction="#onPenaltyRangeChanged" />
                <Label fx:id="penaltyToLabel" minWidth="-Infinity" text="Đến" />
                <DatePicker fx:id="penaltyToDate" minWidth="170.0" prefWidth="170.0" onAction="#onPenaltyRangeChanged" />
            </children>
        </HBox>
        <Label fx:id="penaltyStatusLabel" styleClass="text-muted" wrapText="true" />
        <TableView fx:id="penaltyTable" minHeight="100.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="penaltyDateColumn" prefWidth="110.0" text="Ngày" />
                <TableColumn fx:id="penaltyDescriptionColumn" prefWidth="320.0" text="Mô tả từ sàn" />
                <TableColumn fx:id="penaltyOrderColumn" prefWidth="170.0" text="Mã đơn" />
                <TableColumn fx:id="penaltyProductColumn" prefWidth="170.0" text="Sản phẩm" />
                <TableColumn fx:id="penaltyAmountColumn" prefWidth="150.0" text="Số tiền theo sàn" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <children>
                <Label fx:id="penaltyPageLabel" styleClass="text-muted" />
                <Button fx:id="penaltyPreviousButton" onAction="#onPenaltyPrevious" text="Trước" />
                <Button fx:id="penaltyNextButton" onAction="#onPenaltyNext" text="Sau" />
            </children>
        </HBox>
    </children>
</VBox>
