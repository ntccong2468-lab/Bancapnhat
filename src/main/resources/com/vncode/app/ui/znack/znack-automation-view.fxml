<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox spacing="30" styleClass="znack-root,app-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vncode.app.ui.znack.ZnackAutomationController">
 <padding><Insets top="30" right="30" bottom="20" left="30"/></padding>
 <Label fx:id="titleLabel" styleClass="h2" text="%znack.title"/>
 <Label fx:id="authStatusLabel" styleClass="text-muted" visible="false" managed="false"/>
 <TabPane styleClass="packing-tabs" VBox.vgrow="ALWAYS">
  <tabs>
   <Tab fx:id="informationTab" closable="false" text="%znack.tab.information">
    <ScrollPane fitToWidth="true" styleClass="edge-to-edge">
     <VBox spacing="16">
      <padding><Insets top="12" bottom="12"/></padding>
      <HBox alignment="CENTER_RIGHT" spacing="8">
       <ProgressIndicator fx:id="accountBusyIndicator" visible="false" managed="false" prefWidth="22" prefHeight="22"/>
       <Button fx:id="accountSettingsButton" onAction="#showAccountSettings" text="%znack.account.open_settings"/>
       <Button fx:id="refreshAccountButton" onAction="#refreshAccountInfo" styleClass="btn-primary" text="%znack.account.refresh"/>
      </HBox>
      <HBox fx:id="accountOwnerCard" spacing="16" alignment="CENTER_LEFT" styleClass="card">
       <VBox spacing="6" HBox.hgrow="ALWAYS">
        <Label fx:id="accountOwnerTitleLabel" styleClass="text-muted" text="%znack.account.owner"/>
        <Label fx:id="accountOwnerLabel" styleClass="h3" wrapText="true"/>
        <Label fx:id="accountInnLabel" styleClass="text-muted"/>
       </VBox>
       <Label fx:id="accountStatusLabel" styleClass="activation-warning" wrapText="true" maxWidth="260"/>
      </HBox>
      <HBox spacing="16">
       <VBox fx:id="accountBalanceCard" minWidth="0" maxWidth="Infinity" spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
        <Label fx:id="accountBalanceTitleLabel" styleClass="text-muted" text="%znack.account.balance"/>
        <Label fx:id="accountBalanceLabel" styleClass="h2"/>
        <ComboBox fx:id="accountBalanceCombo" maxWidth="Infinity" promptText="%znack.account.choose_balance" visible="false" managed="false"/>
        <Label fx:id="accountBalanceUpdatedLabel" styleClass="text-muted" wrapText="true"/>
       </VBox>
       <VBox fx:id="accountCertificateCard" minWidth="0" maxWidth="Infinity" spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
        <Label fx:id="accountCertificateTitleLabel" styleClass="text-muted" text="%znack.account.certificate"/>
        <Label fx:id="accountCertificateLabel" styleClass="h2"/>
        <Label fx:id="accountCertificateDaysLabel" styleClass="text-muted" wrapText="true"/>
       </VBox>
      </HBox>
      <Label fx:id="accountEvidenceLabel" styleClass="text-muted" wrapText="true"/>
     </VBox>
    </ScrollPane>
   </Tab>
    <Tab fx:id="ordersTab" closable="false" text="%znack.tab.kiz_history">
        <TableView fx:id="ordersTable">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="orderIdColumn" prefWidth="180" />
                <TableColumn fx:id="orderGtinColumn" prefWidth="180" />
                <TableColumn fx:id="orderStatusColumn" prefWidth="300" />
            </columns>
        </TableView>
    </Tab>
    <Tab fx:id="deletedTab" closable="false" text="%znack.tab.deleted">
        <VBox spacing="8">
            <padding><Insets top="8"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <TextField fx:id="deletedSearchField" promptText="%kiz_mapping.search_gtin" prefWidth="260" maxWidth="300"/>
                <MenuButton fx:id="deletedCategoryFilterButton" text="%znack.filter.button">
                    <graphic><FontIcon iconLiteral="fth-filter" iconSize="14"/></graphic>
                </MenuButton>
            </HBox>
            <TableView fx:id="deletedTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="deletedGtinColumn" prefWidth="150" />
                    <TableColumn fx:id="deletedNameColumn" prefWidth="400" />
                    <TableColumn fx:id="deletedActionsColumn" prefWidth="110" />
                </columns>
            </TableView>
        </VBox>
    </Tab>
   <Tab fx:id="settingsTab" closable="false" text="%znack.tab.settings">
    <ScrollPane fitToWidth="true" styleClass="edge-to-edge">
     <VBox fx:id="basicSettingsCard" spacing="12" styleClass="card">
      <HBox alignment="CENTER_LEFT" spacing="12">
       <Label fx:id="settingsTitleLabel" styleClass="h3" text="%znack.settings.basic" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
       <Button fx:id="editSettingsButton" text="%znack.settings.edit" onAction="#editSettings" styleClass="btn-primary"><graphic><FontIcon iconLiteral="fth-edit-2" iconSize="18"/></graphic></Button>
      </HBox>
      <Label fx:id="omsIdLabel" text="%znack.oms_id"/>
      <HBox spacing="10" alignment="CENTER_LEFT">
       <TextField fx:id="omsIdField" HBox.hgrow="ALWAYS"/>
       <Button fx:id="omsIdHelpButton" accessibleText="%znack.help.oms_id.button" onAction="#showOmsIdHelp" styleClass="btn-icon"><graphic><FontIcon iconLiteral="fth-help-circle" iconSize="17"/></graphic></Button>
      </HBox>
      <Label fx:id="omsConnectionLabel" text="%znack.oms_connection"/>
      <HBox spacing="10" alignment="CENTER_LEFT">
       <TextField fx:id="omsConnectionField" promptText="%znack.oms_connection_prompt" HBox.hgrow="ALWAYS"/>
       <Button fx:id="omsConnectionHelpButton" accessibleText="%znack.help.oms_connection.button" onAction="#showOmsConnectionHelp" styleClass="btn-icon"><graphic><FontIcon iconLiteral="fth-help-circle" iconSize="17"/></graphic></Button>
      </HBox>
      <VBox fx:id="omsHelpPane" managed="false" spacing="8" styleClass="surface, help-pane" visible="false">
       <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="omsHelpTitleLabel" styleClass="h3" HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeOmsHelpButton" onAction="#closeOmsHelp" text="%common.close"/>
       </HBox>
       <Label fx:id="omsHelpDescriptionLabel" wrapText="true"/>
       <Label fx:id="omsHelpStepsTitleLabel" styleClass="text-strong" text="%znack.help.steps_title"/>
       <Label fx:id="omsHelpStepsLabel" styleClass="text-muted" wrapText="true"/>
       <Label fx:id="omsHelpRecognizeTitleLabel" styleClass="text-strong" text="%znack.help.recognize_title"/>
       <Label fx:id="omsHelpRecognizeLabel" styleClass="text-muted" wrapText="true"/>
       <Label fx:id="omsHelpWarningLabel" styleClass="help-warning" wrapText="true"/>
      </VBox>
      <GridPane fx:id="connectionPanels" hgap="0" vgap="12">
       <VBox fx:id="catalogPanel" spacing="10" minWidth="0">
        <Label fx:id="catalogTitleLabel" text="%znack.settings.catalog_key"/>
        <Label fx:id="catalogHelpLabel" text="%znack.catalog.help" visible="false" managed="false"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
         <PasswordField fx:id="catalogKeyField" promptText="%znack.catalog.key_prompt" HBox.hgrow="ALWAYS"/>
         <Button onAction="#showCatalogHelp" styleClass="btn-icon"><graphic><FontIcon iconLiteral="fth-help-circle" iconSize="17"/></graphic></Button>
        </HBox>
        <FlowPane fx:id="catalogActions" hgap="8" vgap="6" visible="false" managed="false">
         <Button fx:id="checkCatalogButton" onAction="#checkCatalogConnection" text="%znack.catalog.check"/>
         <Button fx:id="removeCatalogButton" onAction="#removeCatalogKey" text="%znack.catalog.remove"/>
        </FlowPane>
        <Label fx:id="catalogStatusLabel" wrapText="true" styleClass="text-muted" visible="false" managed="false"/>
       </VBox>
       <VBox spacing="10" GridPane.rowIndex="1" minWidth="0">
        <Label fx:id="purchaseMethodLabel" text="%znack.settings.purchase_method"/>
        <ComboBox fx:id="productionMethodCombo" maxWidth="Infinity" disable="true"/>
        <Label fx:id="purchaseMethodHint" text="%znack.settings.purchase_hint" wrapText="true" styleClass="text-muted"/>
       </VBox>
       <VBox fx:id="signaturePanel" spacing="10" minWidth="0" GridPane.rowIndex="2">
        <Label fx:id="signatureTitleLabel" styleClass="h3" text="%znack.digital_signature"/>
        <ComboBox fx:id="signatureCertificateCombo" minWidth="0" maxWidth="Infinity"/>
        <Button fx:id="testSignatureButton" onAction="#testSignature" styleClass="btn-primary" text="%znack.signature.test"><tooltip><Tooltip text="%znack.signature.help"/></tooltip></Button>
        <Label fx:id="signatureSummaryLabel" styleClass="text-muted"/>
       </VBox>
      </GridPane>
      <CheckBox fx:id="autoIntroductionCheck" text="%znack.auto_introduction" visible="false" managed="false"/>
      <HBox alignment="CENTER_RIGHT"><Button fx:id="saveButton" defaultButton="true" onAction="#save" styleClass="btn-primary" text="%znack.save"/></HBox>
     </VBox>
    </ScrollPane>
   </Tab>
    <Tab fx:id="productsTab" closable="false" text="%znack.tab.products">
        <VBox spacing="8">
            <padding><Insets top="8"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <TextField fx:id="productSearchField" promptText="%kiz_mapping.search_gtin" prefWidth="260" maxWidth="300"/>
                <MenuButton fx:id="productCategoryFilterButton" text="%znack.filter.button">
                    <graphic><FontIcon iconLiteral="fth-filter" iconSize="14"/></graphic>
                </MenuButton>
                <Button fx:id="deleteSelectedButton" disable="true" onAction="#deleteSelectedProducts" styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="15"/></graphic>
                </Button>
                <ProgressIndicator fx:id="productBusyIndicator" managed="false" visible="false"
                                   prefWidth="20" prefHeight="20" minWidth="20" minHeight="20"/>
            </HBox>
            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="productSelectColumn" maxWidth="44" minWidth="44" prefWidth="44" resizable="false" sortable="false"/>
                    <TableColumn fx:id="productGtinColumn" prefWidth="150" />
                    <TableColumn fx:id="productNameColumn" prefWidth="320" />
                    <TableColumn fx:id="productCategoryColumn" prefWidth="160" />
                    <TableColumn fx:id="productTnVedColumn" prefWidth="120" />
                    <TableColumn fx:id="productActionsColumn" prefWidth="80" />
                </columns>
            </TableView>
        </VBox>
    </Tab>
    <Tab fx:id="logsTab" closable="false" text="%znack.tab.logs">
        <TableView fx:id="logsTable">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="logTimeColumn" prefWidth="180" />
                <TableColumn fx:id="logActionColumn" prefWidth="150" />
                <TableColumn fx:id="logEntityColumn" prefWidth="150" />
                <TableColumn fx:id="logSeverityColumn" prefWidth="100" />
                <TableColumn fx:id="logResultColumn" prefWidth="300" />
            </columns>
        </TableView>
    </Tab>
  </tabs>
 </TabPane>
</VBox>
