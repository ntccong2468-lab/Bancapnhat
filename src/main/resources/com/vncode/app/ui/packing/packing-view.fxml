<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vncode.app.ui.packing.PackingController" styleClass="app-page">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="titleLabel" styleClass="h2" text="Упаковка WB" />
                <ProgressIndicator fx:id="refreshLoading" maxHeight="18.0" maxWidth="18.0" prefHeight="18.0" prefWidth="18.0" visible="false" />
                <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefresh" prefHeight="28.0" text="Обновить заказы">
                    <graphic>
                        <FontIcon iconLiteral="fth-refresh-cw" iconSize="15" />
                    </graphic>
                </Button>
            </children>
        </HBox>
        <TabPane fx:id="packingTabPane" styleClass="packing-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab fx:id="newOrdersTab" text="Новые">
                    <content>
                        <VBox spacing="8.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="surface filter-bar">
                                    <children>
                                        <TextField fx:id="newOrderSearchField" prefHeight="28.0" prefWidth="320.0" promptText="Поиск по заказу, товару, артикулу..." />
                                        <MenuButton fx:id="categoryFilterMenuButton" prefHeight="28.0" prefWidth="200.0" text="Все категории" />
                                        <Button fx:id="clearFiltersButton" alignment="CENTER" mnemonicParsing="false" onAction="#onClearNewOrderFilters" prefHeight="28.0" prefWidth="28.0">
                                            <styleClass>
                                                <String fx:value="btn-icon" />
                                            </styleClass>
                                            <graphic>
                                                <FontIcon iconLiteral="fth-x" iconSize="15" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                                <FlowPane fx:id="selectionActionBar" alignment="CENTER_LEFT" managed="false" hgap="10.0" vgap="8.0" styleClass="surface selection-action-bar" visible="false">
                                    <children>
                                        <Label fx:id="selectedCountLabel" styleClass="text-secondary text-bold" text="0 selected" />
                                        <Button fx:id="newShipmentButton" mnemonicParsing="false" onAction="#onNewShipment" prefHeight="28.0" text="New shipment">
                                            <styleClass>
                                                <String fx:value="button" />
                                                <String fx:value="btn-success" />
                                            </styleClass>
                                        </Button>
                                        <Button fx:id="addToShipmentButton" mnemonicParsing="false" onAction="#onAddToShipment" prefHeight="28.0" text="Add to shipment">
                                            <styleClass>
                                                <String fx:value="button" />
                                                <String fx:value="btn-primary" />
                                            </styleClass>
                                        </Button>
                                    </children>
                                </FlowPane>
                                <Label fx:id="emptyNewOrdersLabel" styleClass="text-muted" text="Нет новых заказов." visible="false" managed="false" />
                                <TableView fx:id="newOrdersTable" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="selectedTC" maxWidth="46.0" minWidth="46.0" prefWidth="46.0" resizable="false" text="" />
                                        <TableColumn fx:id="orderDateTC" minWidth="160.0" prefWidth="180.0" text="Дата" />
                                        <TableColumn fx:id="imageTC" minWidth="70.0" prefWidth="78.0" text="Фото" />
                                        <TableColumn fx:id="productTC" minWidth="300.0" prefWidth="550.0" text="Товар" />
                                        <TableColumn fx:id="priceTC" minWidth="100.0" prefWidth="110.0" text="Цена" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab fx:id="preparationTab" text="Сборка">
                    <content>
                        <VBox spacing="10.0">
                            <children>
                                <TableView fx:id="preparationTable" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="preparationSupplyTC" minWidth="260.0" prefWidth="360.0" text="Поставка" />
                                        <TableColumn fx:id="preparationStatusTC" minWidth="110.0" prefWidth="120.0" text="Статус" />
                                        <TableColumn fx:id="preparationCountTC" minWidth="90.0" prefWidth="110.0" text="Товары" />
                                        <TableColumn fx:id="preparationCreatedTC" minWidth="160.0" prefWidth="190.0" text="Дата" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab fx:id="dispatchTab" text="Доставка">
                    <content>
                        <VBox spacing="8"><TableView fx:id="dispatchTable" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="dispatchSupplyTC" minWidth="260.0" prefWidth="360.0" text="Поставка" />
                                <TableColumn fx:id="dispatchStatusTC" minWidth="110.0" prefWidth="120.0" text="Статус" />
                                <TableColumn fx:id="dispatchCountTC" minWidth="90.0" prefWidth="110.0" text="Товары" />
                                <TableColumn fx:id="dispatchCreatedTC" minWidth="160.0" prefWidth="190.0" text="Дата" />
                                <TableColumn fx:id="dispatchActionTC" minWidth="120.0" prefWidth="140.0" text="" />
                            </columns>
                        </TableView><Button fx:id="dispatchMoreButton" text="Load more" onAction="#onLoadMoreDispatch" /></VBox>
                    </content>
                </Tab>
                <Tab fx:id="debtTab" text="Đơn nợ">
                    <content>
                        <VBox spacing="8.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Button fx:id="debtBackButton" text="← Shipment" onAction="#onDebtBack" managed="false" visible="false" />
                                    <Label fx:id="debtHeading" minWidth="0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" styleClass="text-secondary" text="Shipment có đơn nợ" />
                                    <ProgressIndicator fx:id="debtLoading" maxHeight="18.0" maxWidth="18.0" prefHeight="18.0" prefWidth="18.0" visible="false" managed="false" />
                                    <Button fx:id="debtRefreshButton" text="Cập nhật" onAction="#onRefreshDebt" />
                                </HBox>
                                <Label fx:id="debtWarning" wrapText="true" styleClass="text-muted" visible="false" managed="false" />
                                <TableView fx:id="debtShipmentsTable" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="debtShipmentNameTC" minWidth="220.0" prefWidth="350.0" text="Shipment" />
                                        <TableColumn fx:id="debtShipmentStatusTC" minWidth="150.0" prefWidth="170.0" text="Trạng thái" />
                                        <TableColumn fx:id="debtShipmentCountTC" minWidth="90.0" prefWidth="110.0" text="Đơn nợ" />
                                        <TableColumn fx:id="debtShipmentDateTC" minWidth="150.0" prefWidth="180.0" text="Ngày" />
                                    </columns>
                                </TableView>
                                <TableView fx:id="debtOrdersTable" VBox.vgrow="ALWAYS" visible="false" managed="false">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="debtOrderDateTC" minWidth="150.0" prefWidth="180.0" text="Order ID" />
                                        <TableColumn fx:id="debtImageTC" minWidth="65.0" prefWidth="75.0" text="Ảnh" />
                                        <TableColumn fx:id="debtProductTC" minWidth="230.0" prefWidth="430.0" text="Sản phẩm" />
                                        <TableColumn fx:id="debtPriceTC" minWidth="80.0" prefWidth="90.0" text="Giá" />
                                        <TableColumn fx:id="debtOrderStatusTC" minWidth="175.0" prefWidth="210.0" text="Trạng thái WB" />
                                        <TableColumn fx:id="debtPrintTC" minWidth="64.0" prefWidth="72.0" maxWidth="90.0" text="" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>
