<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vncode.app.ui.gtinsync.GtinSyncController" styleClass="app-page">
  <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
  <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><content><VBox spacing="8">
  <Label fx:id="titleLabel" styleClass="h2"/>
  <Label fx:id="scopeLabel" styleClass="text-bold"/>
  <Label fx:id="capabilityLabel" wrapText="true" styleClass="text-muted"/>
  <FlowPane hgap="8" vgap="8">
    <Button fx:id="syncButton" onAction="#onSync"/>
    <Button fx:id="loadButton" onAction="#onLoad"/>
    <Button fx:id="selectButton" onAction="#onSelectExact"/>
    <Button fx:id="clearButton" onAction="#onClear"/>
  </FlowPane>
  <TextField fx:id="searchField"/>
  <TableView fx:id="productTable" prefHeight="240" minHeight="120"/>
  <FlowPane hgap="8" vgap="8">
    <ComboBox fx:id="gtinBox" prefWidth="300"/>
    <ComboBox fx:id="operationBox" prefWidth="180"/>
    <ComboBox fx:id="oldBarcodeBox" prefWidth="190"/>
    <Button fx:id="mappingButton" onAction="#onMapping"/>
    <Button fx:id="previewButton" onAction="#onPreview"/>
    <Button fx:id="fullSyncButton" onAction="#onFullSync"/>
    <Button fx:id="confirmButton" onAction="#onConfirm" disable="true"/>
  </FlowPane>
  <Label fx:id="wbPriceImpactLabel" wrapText="true" visible="false" managed="false" styleClass="text-muted"/>
  <Label fx:id="statusLabel" wrapText="true"/>
  <TitledPane fx:id="reportDetailsPane" text="Report" expanded="false" animated="false"><content><VBox spacing="8">
  <TextArea fx:id="previewArea" editable="false" wrapText="true" prefRowCount="3" maxHeight="100"/>
  <TableView fx:id="historyTable" prefHeight="140" minHeight="80"/>
  </VBox></content></TitledPane>
  </VBox></content></ScrollPane></center>
  <bottom><FlowPane hgap="8" vgap="8">
    <padding><Insets top="8" bottom="8"/></padding>
    <Button fx:id="pauseButton" onAction="#onPause"/>
    <Button fx:id="resumeButton" onAction="#onResume"/>
    <Button fx:id="cancelButton" onAction="#onCancel"/>
    <Button fx:id="reconcileButton" onAction="#onReconcile"/>
    <Button fx:id="csvButton" onAction="#onCsv"/>
    <Button fx:id="xlsxButton" onAction="#onXlsx"/>
  </FlowPane></bottom>
</BorderPane>
