    "organizationRateLimit": "General and per-method counters in API-Usage-Limit and API-Method-Usage-Limit; new series five minutes after first request; no universal numeric quota asserted.",
    "allocation": {
      "method": "GET",
      "path": "/v3/generate-gtins",
      "section": "3.2.1",
      "mutation": true,
      "parameters": [
        "quantity",
        "exist",
        "supplier_key"
      ],
      "response": [
        "monthly-limit.limit",
        "monthly-limit.usage",
        "drafts[].gtin"
      ],
      "automaticWriteRetry": false
    },
    "feed": {
      "method": "POST",
      "path": "/v3/feed",
      "section": "3.2.2",
      "contentType": "application/json",
      "maximumProducts": 500,
      "response": "result.feed_id",
      "errors": {
        "400": "schema error",
        "413": "feed too large or too many products"
      },
      "automaticWriteRetry": false,
      "documentedMaximumSize": "25 МБ"
    },
    "feedStatus": {
      "method": "GET",
      "path": "/v3/feed-status",
      "parameters": [
        "feed_id",
        "verbose"
      ],
      "statuses": [
        "Received",
        "Moderated",
        "Signed",
        "Rejected",
        "Processing"
      ],
      "retention": "one year"
    },
    "ownCard": {
      "method": "GET",
      "path": "/v3/feed-product",
      "identity": [
        "gtin/identified_by",
        "good_id"
      ],
      "publication": "Read exact identity, business revision and explicit signed/published state; never infer from feed ack."
    },
    "signingDocument": {
      "method": "POST",
      "path": "/v3/feed-product-document",
      "section": "3.4.1",
      "maximumProducts": 10,
      "request": [
        "goodIds",
        "gtins",
        "publicationAgreement"
      ],
      "response": [
        "xmls[].goodId",
        "xmls[].xml",
        "errors"
      ]
    },
    "signature": {
      "method": "POST",
      "path": "/v3/feed-product-sign-pkcs",
      "section": "3.4.3",
      "maximumProducts": 10,
      "request": [
        "goodId",
        "base64Xml",
        "signature"
      ],
      "profile": "detached CAdES PKCS#7; original XML and signature encoded separately as Base64",
      "response": [
        "signed[]",
        "errors[].goodId",
        "errors[].message"
      ],
      "automaticWriteRetry": false
    }
  },
