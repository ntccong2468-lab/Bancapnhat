    CHECK --> STATE{"Từng mã / thẻ / giấy tờ đã sẵn sàng?"}
    STATE -- "APPLIED và hồ sơ hợp lệ" --> DOC["Ký và gửi LP_INTRODUCE_GOODS; chờ duyệt"]
    STATE -- "Chưa đạt" --> WAIT["Giữ đúng đơn mua; tiếp tục kiểm trạng thái"]
    STATE -- "Đã INTRODUCED" --> DONE["Đã lưu thông"]
    DOC --> VERIFY["Đọc lại trạng thái tài liệu và từng mã"]
    VERIFY -- "Đủ bằng chứng" --> DONE
    CHECK -. "Chữ ký chưa được phép / bị hủy/lỗi" .-> PAUSE["Dừng ký cục bộ; không lên lịch tự ký lại"]
    DOC -. "Chữ ký bị chặn" .-> PAUSE
    PAUSE --> RESUME["Đúng shop / Tiếp tục đúng lô; không mua lại"]
