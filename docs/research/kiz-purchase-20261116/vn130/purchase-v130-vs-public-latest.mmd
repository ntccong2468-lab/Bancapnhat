flowchart TD
    A["Bấm Mua KIZ"] --> V{"Phiên bản"}
    V -- "1.3.0" --> OLD["Giữ autoIntroduction trong cấu hình"]
    V -- "1.6.10 phát hành" --> NEW["enqueueForCirculation: bật tự đưa vào lưu thông cho lô"]
    OLD --> CORE["Ký + SUZ POST order → poll status → tải đủ mã"]
    NEW --> CORE
    CORE --> MODE{"Điều kiện kết thúc"}
    MODE -- "1.3.0 và autoIntroduction tắt" --> DL["COMPLETED: đã tải mã, chưa xác minh lưu thông"]
